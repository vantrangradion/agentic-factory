{
  "name": "@agentic-factory/monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "The Project-Agnostic, Globally Reusable Software Factory Engine for Agentic Software Development",
  "author": "Antigravity Engineering",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "test": "pnpm -r --filter './packages/*' test",
    "guard": "node packages/guards/dist/cli.js run",
    "clean": "rm -rf packages/*/dist packages/*/.tsbuildinfo node_modules",
    "link-plugin": "mkdir -p ~/.gemini/config/plugins && ln -sfn $(pwd)/plugin ~/.gemini/config/plugins/agentic-factory"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
