{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgenticFactoryConfig",
  "type": "object",
  "properties": {
    "extends": {
      "description": "Presets applied before this file. Built-in: agentic-factory/recommended, agentic-factory/plain-ux. Relative paths load shared JSON configs.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "architecture": {
          "type": "string",
          "description": "Free-form label, e.g. modular-monorepo, single-package, hexagonal, clean-architecture, microservice."
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "typescript",
              "python"
            ]
          },
          "description": "Restrict guards to these language adapters. Omit to route every file by extension."
        }
      }
    },
    "guards": {
      "type": "object",
      "properties": {
        "noCycles": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "rootDir": {
              "type": "string"
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "boundaries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "package": {
                "type": "string"
              },
              "disallowImportsFrom": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "package",
              "disallowImportsFrom"
            ]
          }
        },
        "plainLanguage": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "targetDirs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "forbiddenTerms": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "disallowEmDashes": {
              "type": "boolean"
            },
            "disallowEmojis": {
              "type": "boolean"
            }
          }
        },
        "secrets": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "patterns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "todoIssueLinks": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "targetDirs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "issuePattern": {
              "type": "string"
            }
          }
        },
        "commentedCode": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "targetDirs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "deadExports": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "rootDir": {
              "type": "string"
            },
            "entryPoints": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "testOnlyKeys": {
          "type": "object",
          "description": "Opt-in. Fails when production code reads a property that only tests set.",
          "properties": {
            "enabled": { "type": "boolean" },
            "rootDir": { "type": "string" },
            "exclude": { "type": "array", "items": { "type": "string" } },
            "testPaths": { "type": "array", "items": { "type": "string" }, "description": "Path fragments that mark test code, beyond *.test.* and *.spec.* files." },
            "ignoreKeys": { "type": "array", "items": { "type": "string" }, "description": "Keys never reported, e.g. fields of a library's types that tests fake." }
          }
        }
      }
    },
    "testing": {
      "type": "object",
      "properties": {
        "targetCoverage": {
          "type": "number"
        },
        "maxSuiteDurationMs": {
          "type": "number"
        },
        "requireSyntheticScenarios": {
          "type": "boolean"
        }
      }
    },
    "agent": {
      "type": "object",
      "description": "Settings for the autonomous agent loop (@agentic-factory/loop). Everything project-specific about the loop lives here.",
      "additionalProperties": false,
      "required": [
        "model",
        "gates"
      ],
      "properties": {
        "runner": {
          "type": "string",
          "enum": [
            "antigravity-cli",
            "claude-code"
          ],
          "description": "Agent CLI: antigravity-cli (agy, Gemini models, the default) or claude-code (claude, Claude models). Model ids in model, routes, review.model and budget.pricing must belong to this runner's vendor."
        },
        "model": {
          "type": "string",
          "description": "Default model for issues that no route matches."
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ready": {
              "type": "string"
            },
            "working": {
              "type": "string"
            },
            "prOpen": {
              "type": "string"
            },
            "needsHuman": {
              "type": "string"
            }
          },
          "description": "Issue labels. Defaults: agent:ready, agent:working, agent:pr-open, agent:needs-human."
        },
        "context": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Files the agent reads before changing anything. Default: [\"AGENTS.md\"]."
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "description": "Gate ladder, cheapest first. The loop stops at the first failure.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "run"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "run": {
                "type": "string",
                "description": "Shell command run from the project root."
              },
              "timeoutMs": {
                "type": "number",
                "minimum": 1
              }
            }
          }
        },
        "tdd": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Run a tests-only red phase that must fail before the implementation. Default true."
            },
            "redGate": {
              "type": "string",
              "description": "Gate that must fail after the red phase. Default \"test\"."
            },
            "testFiles": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Globs that identify test files."
            }
          }
        },
        "protectedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Globs the agent may never change; the loop reverts them. .factoryrc.json and .github/** are always protected."
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "description": "Attempts per phase before the issue goes to a human. Default 3."
        },
        "sessionTimeoutMs": {
          "type": "number",
          "minimum": 1,
          "description": "Wall-clock limit for one agent session. Default 30 minutes."
        },
        "branchPrefix": {
          "type": "string",
          "description": "Default \"agent/\"."
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "weeklyUsd": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Weekly spend cap in USD. Omit for no cap."
            },
            "bugOnlyAt": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1,
              "description": "Fraction of the cap after which only bug issues run. Default 0.8."
            },
            "stopAt": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Fraction of the cap after which the loop stops until Monday. Default 1.0."
            },
            "bugLabels": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Default [\"bug\"]."
            },
            "utcOffset": {
              "type": "string",
              "pattern": "^[+-]\\d{2}:\\d{2}$",
              "description": "Offset for the start of the week (Monday 00:00), e.g. \"+07:00\"."
            },
            "pricing": {
              "description": "USD per million tokens: one price for every model, or a map from model id to price. Required with weeklyUsd.",
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "inputPerMTok",
                    "outputPerMTok"
                  ],
                  "properties": {
                    "inputPerMTok": {
                      "type": "number",
                      "minimum": 0
                    },
                    "outputPerMTok": {
                      "type": "number",
                      "minimum": 0
                    },
                    "cachedInputPerMTok": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "inputPerMTok",
                      "outputPerMTok"
                    ],
                    "properties": {
                      "inputPerMTok": {
                        "type": "number",
                        "minimum": 0
                      },
                      "outputPerMTok": {
                        "type": "number",
                        "minimum": 0
                      },
                      "cachedInputPerMTok": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        "routes": {
          "type": "array",
          "description": "Fixed label-based routing to other models of the same vendor. The first route with a matching issue label wins.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "labels",
              "model"
            ],
            "properties": {
              "labels": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "model": {
                "type": "string"
              }
            }
          }
        },
        "setup": {
          "type": "string",
          "description": "Installs dependencies in a fresh clone before a local run, e.g. \"pnpm install --frozen-lockfile\"."
        },
        "ledgerBranch": {
          "type": "string",
          "description": "Orphan branch holding one JSON record per run. Default \"factory-ledger\"."
        },
        "reviewers": {
          "type": "object",
          "additionalProperties": false,
          "description": "GitHub logins to notify. The loop posts as the runner, and GitHub never notifies people of their own actions.",
          "properties": {
            "plan": { "type": "array", "items": { "type": "string" }, "description": "Asked to review plan pull requests, and mentioned when a run needs a person." },
            "pr": { "type": "array", "items": { "type": "string" }, "description": "Asked to review pull requests whose gates pass." }
          }
        },
        "notify": {
          "type": "object",
          "additionalProperties": false,
          "description": "Also post to a chat channel. Tokens come from the environment, never from this file.",
          "properties": {
            "workspace": {
              "type": "object",
              "additionalProperties": false,
              "required": ["channel"],
              "description": "Gradion Workspace. Token: AGENTIC_LOOP_WORKSPACE_TOKEN, with Write access to this channel.",
              "properties": {
                "url": { "type": "string", "description": "Default https://workspace.gradion.com" },
                "channel": { "type": "string", "description": "Channel id from the channel's address, e.g. G-6jh00udb." },
                "cc": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "plan": { "type": "string", "description": "Text added for plans and runs that need a person, e.g. @dylan." },
                    "pr": { "type": "string", "description": "Text added for pull requests whose gates pass." }
                  }
                }
              }
            }
          }
        },
        "sandbox": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image"],
          "description": "Run setup and gates in Docker instead of on the host. Each gate run gets a fresh copy of only the files the commit would contain; setup has network, gates do not. With agent: true the agent session runs in a container from the same image as well.",
          "properties": {
            "image": { "type": "string", "minLength": 1, "description": "Docker image with the project's toolchain, e.g. one built from node:22 with pnpm installed." },
            "env": { "type": "array", "items": { "type": "string" }, "description": "Names of host environment variables passed into the containers. Default none." },
            "gateNetwork": { "type": "boolean", "description": "Give gates network access. Default false." },
            "memory": { "type": "string", "description": "Docker memory limit, e.g. \"4g\"." },
            "cpus": { "type": "number", "exclusiveMinimum": 0, "description": "Docker CPU limit, e.g. 2." },
            "agent": { "type": "boolean", "description": "Run each agent session in a container from image (which must have the runner's CLI installed: agy or claude) instead of on the host. Default false. Sign in once per machine with agentic-loop login." },
            "authVolume": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]+$", "description": "Docker volume holding the agent's login. Default agentic-loop-agy-auth for agy, agentic-loop-claude-auth for Claude Code." }
          }
        }
      }
    }
  }
}
